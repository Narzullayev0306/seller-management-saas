APP_NAME=seller-management-saas
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000

# Postgres
POSTGRES_USER=seller
POSTGRES_PASSWORD=seller_dev_password
POSTGRES_DB=seller_management
# Local Docker dev DB (tests still use this)
DATABASE_URL=postgresql+psycopg://seller:seller_dev_password@postgres:5432/seller_management
# Production: Supabase pooler (percent-encode special chars in the password)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase project (Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Redis
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (verification, password reset, team invites)
# When EMAIL_ENABLED=false, emails are logged to the backend console instead.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
